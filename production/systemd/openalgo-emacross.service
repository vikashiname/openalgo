[Unit]
Description=OpenAlgo 1H EMA/MACD Live Strategy Engine (EMACROSS)
After=network.target openalgo.service
Wants=openalgo.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/fyersawsog
Environment=PYTHONUNBUFFERED=1
Environment=HEARTBEAT_FILE=/home/ubuntu/fyersawsog/strategies/liveonopenalgo/emacross_heartbeat.json
Environment=STATE_FILE=/home/ubuntu/fyersawsog/strategies/liveonopenalgo/emacrossopen_state.json
Environment=LOG_FILE=/home/ubuntu/fyersawsog/log/strategies/emacrossopen.log
ExecStart=/home/ubuntu/fyersawsog/.venv/bin/python strategies/liveonopenalgo/emacrossopen.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
