[Unit]
Description=OpenAlgo NFO Single-Stock Futures Long-Unwinding Strategy (OIFNO)
After=network.target openalgo.service
Wants=openalgo.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/fyersawsog
Environment=PYTHONUNBUFFERED=1
Environment=PHASE7_MODE=SHADOW
Environment=HEARTBEAT_FILE=/home/ubuntu/fyersawsog/strategies/liveonopenalgo/oifno_heartbeat.json
Environment=STATE_FILE=/home/ubuntu/fyersawsog/production/audit/oifno_state.json
Environment=LOG_FILE=/home/ubuntu/fyersawsog/log/strategies/oifno.log
ExecStart=/home/ubuntu/fyersawsog/.venv/bin/python strategies/liveonopenalgo/oifno.py --mode live-paper
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
