[Unit]
Description=OpenAlgo Multi-Asset NFO MACD Crossover Engine (MACDFNO)
After=network.target openalgo.service
Wants=openalgo.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/fyersawsog
Environment=PYTHONUNBUFFERED=1
Environment=HEARTBEAT_FILE=/home/ubuntu/fyersawsog/strategies/liveonopenalgo/macdfno_heartbeat.json
Environment=STATE_FILE=/home/ubuntu/fyersawsog/strategies/liveonopenalgo/macdfno_state.json
Environment=LOG_FILE=/home/ubuntu/fyersawsog/log/strategies/macd_fno.log
ExecStart=/home/ubuntu/fyersawsog/.venv/bin/python strategies/liveonopenalgo/macdfno.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
